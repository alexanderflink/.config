[global]
frame_width = 1
frame_color = "#88c0d0"
padding = 10
horizontal_padding = 10
width = (300, 500)
height = (20, 50)
origin = top-center
offset = 0x0
layer = top
font = pango:SauceCodePro Nerd Font 9

[urgency_low]
    background = "#4c566a"
	foreground = "#2e3440"

[urgency_normal]
    background = "#4c566a"
	foreground = "#eceff4"

[urgency_critical]
	background = "#bf616a"
	foreground = "#eceff4"

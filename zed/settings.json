{
  "assistant": {
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-3-5-sonnet-latest"
    },
    "version": "2"
  },
  "features": {
    "inline_completion_provider": "supermaven"
  },
  "base_keymap": "None",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "ui_font_family": "Source Code Pro",
  "buffer_font_family": "Source Code Pro",
  "project_panel": {
    "auto_fold_dirs": false
  },
  "theme": {
    "mode": "dark",
    "light": "Solarized Light",
    "dark": "Nord"
  }
}
